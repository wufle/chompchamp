<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay controls; padded by system-bar insets in MainActivity (Android 15 edge-to-edge).
         Sizes, colours and transparency are applied in code from Appearance settings. -->
    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- User-positioned data fields. -->
        <FrameLayout
            android:id="@+id/fieldsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp" />

        <!-- Mode switcher pill: Chart / Route / Navigate / Fish -->
        <TextView
            android:id="@+id/btnMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:contentDescription="@string/mode" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:contentDescription="@string/menu"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu" />

        <!-- Alerts: no-fishing zone, restricted area, anchor drag. Tap for details. -->
        <TextView
            android:id="@+id/zoneBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="72dp"
            android:layout_marginTop="68dp"
            android:layout_marginEnd="72dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/ui_on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/editBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit_hint"
                android:textColor="@color/ui_on_surface"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnDoneEditing"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/done"
                android:textColor="@color/ui_accent" />
        </LinearLayout>

        <!-- Per-mode controls (route planner, navigation, fishing) -->
        <LinearLayout
            android:id="@+id/modePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="68dp"
            android:layout_marginEnd="68dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/modeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/ui_on_surface"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/modeButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnLayers"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="12dp"
            android:contentDescription="@string/layers"
            android:scaleType="centerInside"
            android:src="@drawable/ic_layers" />

        <ImageButton
            android:id="@+id/btnLocate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:contentDescription="@string/follow_boat"
            android:scaleType="centerInside"
            android:src="@drawable/ic_my_location" />
    </FrameLayout>
</FrameLayout>
